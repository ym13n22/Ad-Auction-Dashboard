<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.softengproj.uicontroller.ChartsController">
  <children>
    <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="590.0" VBox.vgrow="NEVER">
      <children>
        <Button fx:id="back" mnemonicParsing="false" onAction="#back" prefHeight="26.0" prefWidth="99.0" text="Back to menu" HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" prefHeight="46.0" prefWidth="189.0" HBox.hgrow="ALWAYS">
          <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Dashboard" />
          </children>
          <HBox.margin>
            <Insets />
          </HBox.margin>
        </HBox>
        <ButtonBar prefHeight="54.0" prefWidth="347.0" HBox.hgrow="NEVER">
          <buttons>
            <Button fx:id="load" mnemonicParsing="false" onAction="#load" text="Load" />
            <Button fx:id="unload" mnemonicParsing="false" onAction="#unload" text="Unload" />
            <Button fx:id="campaign" mnemonicParsing="false" onAction="#campaign" text="Campaign" />
                  <Button fx:id="export" mnemonicParsing="false" onAction="#export" text="Export" />
          </buttons>
        </ButtonBar>
      </children>
      <VBox.margin>
        <Insets left="10.0" />
      </VBox.margin>
    </HBox>
    <VBox>
      <children>
        <HBox prefHeight="54.0" prefWidth="600.0">
          <children>
            <ButtonBar prefHeight="40.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
              <buttons>
                <Button mnemonicParsing="false" onAction="#changeBounce" text="Bounce" />
                <Button mnemonicParsing="false" onAction="#addFilters" text="filters" />
                <ComboBox fx:id="metricOptions" onAction="#metrics" prefWidth="150.0" promptText="Metrics" />
                <ComboBox fx:id="time" prefWidth="150.0" promptText="time" />
              </buttons>
              <HBox.margin>
                <Insets right="20.0" />
              </HBox.margin>
            </ButtonBar>
          </children>
        </HBox>
        <HBox VBox.vgrow="ALWAYS">
          <children>
            <HBox HBox.hgrow="ALWAYS">
              <children>
                <VBox HBox.hgrow="ALWAYS">
                  <children>
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                      <children>
                        <VBox prefHeight="482.0" prefWidth="246.0" HBox.hgrow="ALWAYS">
                          <children>
                            <VBox prefHeight="480.0" prefWidth="329.0" VBox.vgrow="ALWAYS">
                              <children>
                                <TabPane prefHeight="480.0" prefWidth="326.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                  <tabs>
                                    <Tab text="Untitled Tab 1">
                                      <content>
                                        <VBox prefHeight="200.0" prefWidth="100.0">
                                          <children>
                                            <LineChart VBox.vgrow="ALWAYS">
                                              <xAxis>
                                                <CategoryAxis side="BOTTOM" />
                                              </xAxis>
                                              <yAxis>
                                                <NumberAxis side="LEFT" />
                                              </yAxis>
                                            </LineChart>
                                          </children>
                                        </VBox>
                                      </content>
                                    </Tab>
                                    <Tab text="Untitled Tab 2">
                                      <content>
                                        <VBox prefHeight="200.0" prefWidth="100.0">
                                          <children>
                                            <LineChart VBox.vgrow="ALWAYS">
                                              <xAxis>
                                                <CategoryAxis side="BOTTOM" />
                                              </xAxis>
                                              <yAxis>
                                                <NumberAxis side="LEFT" />
                                              </yAxis>
                                            </LineChart>
                                          </children>
                                        </VBox>
                                      </content>
                                    </Tab>
                                  </tabs>
                                </TabPane>
                              </children>
                            </VBox>
                          </children>
                          <HBox.margin>
                            <Insets bottom="20.0" left="20.0" />
                          </HBox.margin>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" prefHeight="268.0" prefWidth="102.0" HBox.hgrow="ALWAYS">
                          <children>
                            <HBox alignment="CENTER" prefHeight="361.0" prefWidth="336.0" VBox.vgrow="ALWAYS">
                              <VBox.margin>
                                <Insets bottom="30.0" right="10.0" />
                              </VBox.margin>
                              <children>
                                <HBox prefHeight="227.0" prefWidth="277.0" spacing="10.0" HBox.hgrow="ALWAYS">
                                  <children>
                                    <VBox fx:id="tablecontainer" HBox.hgrow="ALWAYS">
                                      <children>
                                        <TableView fx:id="table" prefHeight="363.0" prefWidth="190.0" VBox.vgrow="ALWAYS">
                                          <columns>
                                            <TableColumn fx:id="metrics" prefWidth="76.79992598295212" text="Metrics" />
                                            <TableColumn fx:id="computation" prefWidth="75.20004653930664" text="Value" />
                                          </columns>
                                          <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                          </columnResizePolicy>
                                        </TableView>
                                      </children>
                                    </VBox>
                                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                      <children>
                                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Applied filters:" VBox.vgrow="ALWAYS" />
                                        <VBox prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS">
                                          <children>
                                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="None" VBox.vgrow="ALWAYS" />
                                            <Text strokeType="OUTSIDE" strokeWidth="0.0" />
                                            <Text strokeType="OUTSIDE" strokeWidth="0.0" />
                                          </children>
                                        </VBox>
                                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Bounce Definition:" VBox.vgrow="ALWAYS" />
                                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="None" VBox.vgrow="ALWAYS" />
                                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Time granularity:" VBox.vgrow="ALWAYS" />
                                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="None" VBox.vgrow="ALWAYS" />
                                      </children>
                                    </VBox>
                                  </children>
                                </HBox>
                              </children>
                            </HBox>
                          </children>
                        </VBox>
                      </children>
                    </HBox>
                  </children>
                </VBox>
              </children>
            </HBox>
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</VBox>
